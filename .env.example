# YouTube video id for the "Watch it work" section. Leave empty to show the "coming today" state.
NEXT_PUBLIC_DEMO_VIDEO_ID=

# Supabase project that stores the optional post-download answers (table public.signups, SQL in
# README.md). Server-only: the service-role key bypasses Row Level Security, so it must never be
# exposed to the browser (do NOT prefix these with NEXT_PUBLIC_). Leave empty to skip storing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Leave empty to disable the admin page.
ADMIN_PASSWORD=

# Optional but recommended: a read-only GitHub token (fine-grained, public repositories, no
# permissions). Release lookups refresh every 60 seconds; without a token GitHub allows only
# 60 API requests an hour per server IP, which shared hosting can exhaust.
GITHUB_TOKEN=
